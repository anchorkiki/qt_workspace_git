/* 全局样式 */
QWidget {
    font-family: "SimHei", "WenQuanYi Micro Hei", sans-serif; /* 确保中文显示 */
    font-size: 14px;
    background-color: #f5f5f5; /* 全局背景色（浅灰） */
}

/* 主窗口 */
MainWidget {
    background-color: #f5f5f5;
}

.CardsContainer {
    background-color: #f0f0f0; /* 浅灰背景，与小卡片白色区分 */
    border-radius: 10px;       /* 大容器圆角 */
    border: 1px solid #e0e0e0; /* 大容器边框 */
    padding: 5px;              /* 大容器内边距 */
}

/* 数据卡片样式（温度、湿度、光照） */
.Card {
    background-color: white; /* 白色背景 */
    border-radius: 8px;      /* 圆角 */
    padding: 10px;           /* 内边距 */
    border: 1px solid #e0e0e0; /* 浅色边框 */
    margin: 2px 0;           /* 卡片之间的垂直间距 */
}

/* 卡片内的标签 */
.Card QLabel:first-child { /* 左侧名称标签（如“温度：”） */
    color: #666666;
    font-size: 18px;
}

.Card QLabel:last-child {  /* 右侧数值标签（如“25.48°C”） */
    color: #333333;
    font-size: 18px;
    font-weight: bold;
}

/* 按钮样式（如“设置”按钮） */
QPushButton {
    background-color: #409eff; /* 蓝色背景 */
    color: white;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 16px;
    border: none;
}

QPushButton:hover {
    background-color: #66b1ff; /*  hover 效果 */
}

QPushButton:pressed {
    background-color: #3a8ee6; /* 按下效果 */
}

/* 图表容器（折线图和柱状图） */
.ChartContainer {
    background-color: white;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    padding: 5px;
}

/* 右侧空白区域（布局B和C中的占位控件） */
.Placeholder {
    background-color: #e8e8e8;
    border-radius: 8px;
}
